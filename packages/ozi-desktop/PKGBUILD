# The OziOS desktop: oziwm (Wayland compositor) and ozi-shell (bar, dock,
# launcher, quick settings, wallpaper), with an "OziOS" login session.
# Built from a checkout like ozios-settings: OZI_SRC points at it.
pkgname=ozi-desktop
pkgver=0.4.0beta4
pkgrel=2
pkgdesc="OziOS desktop: its own window manager and shell"
arch=(x86_64)
license=(MIT)
depends=(
  'ozios-settings>=0.3.0-7'
  seatd libinput mesa libxkbcommon systemd-libs libdrm pam fontconfig
  python python-pyqt6 qt6-declarative layer-shell-qt
  ttf-overpass wireplumber networkmanager
  xdg-desktop-portal-kde xdg-desktop-portal-gtk bluez-utils power-profiles-daemon
  qt6-svg cachyos-wallpapers
)
makedepends=(rust cargo clang mold)
optdepends=(
  'xwayland-satellite: run X11 programs (Steam, older games)'
  'breeze: the default pointer theme'
  'polkit-kde-agent: password prompts for administrator tasks'
  'dolphin: the file manager Super+E opens'
)
backup=(etc/pam.d/oziwm)
options=(!strip !debug !lto)

build() {
  local src="${OZI_SRC:?OZI_SRC must point at the OziOS source tree}"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --manifest-path "$src/oziwm/Cargo.toml"
  cargo build --release --locked --manifest-path "$src/ozi-terminal/Cargo.toml"
}

check() {
  local src="${OZI_SRC:?}"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked --manifest-path "$src/oziwm/Cargo.toml"
  cargo test --release --locked --manifest-path "$src/ozi-terminal/Cargo.toml"
}

package() {
  local src="${OZI_SRC:?}"
  install -Dm755 "$srcdir/target/release/oziwm" "$pkgdir/usr/bin/oziwm"
  install -Dm755 "$srcdir/target/release/ozi-terminal" "$pkgdir/usr/bin/ozi-terminal"
  install -Dm644 "$src/ozi-terminal/data/ozi-terminal.desktop" "$pkgdir/usr/share/applications/ozi-terminal.desktop"
  install -Dm644 "$src/ozi-terminal/data/ozi-terminal.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ozi-terminal.svg"
  install -Dm755 "$src/shell/ozi-shell" "$pkgdir/usr/bin/ozi-shell"
  install -Dm644 "$src/session/ozi-shell.desktop" "$pkgdir/usr/share/applications/ozi-shell.desktop"
  install -Dm755 "$src/session/ozi-session" "$pkgdir/usr/bin/ozi-session"
  install -Dm755 "$src/session/ozi-session-start" "$pkgdir/usr/lib/ozios/ozi-session-start"
  install -Dm644 "$src/session/ozios.desktop" "$pkgdir/usr/share/wayland-sessions/ozios.desktop"
  install -Dm644 "$src/session/oziwm.pam" "$pkgdir/etc/pam.d/oziwm"
  install -Dm755 "$src/session/ozi-presence" "$pkgdir/usr/bin/ozi-presence"
  install -Dm755 "$src/session/ozi-boot-look" "$pkgdir/usr/lib/ozios/ozi-boot-look"
  install -Dm644 "$src/session/ozi-boot-look.service" "$pkgdir/usr/lib/systemd/system/ozi-boot-look.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../ozi-boot-look.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/ozi-boot-look.service"
  install -Dm644 "$src/session/ozios-portals.conf" "$pkgdir/usr/share/xdg-desktop-portal/ozios-portals.conf"
  install -d "$pkgdir/usr/share/ozios/wallpapers"
  install -m644 "$src"/branding/wallpapers/*.svg "$pkgdir/usr/share/ozios/wallpapers/"
  install -d "$pkgdir/usr/share/ozios/shell/qml"
  install -m644 "$src"/shell/qml/*.qml "$pkgdir/usr/share/ozios/shell/qml/"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
