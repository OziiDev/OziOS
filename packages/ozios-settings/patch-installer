#!/usr/bin/python3 -I
"""Rewrite the Calamares installer on the live system for OziOS.

Calamares installs software from lists that name CachyOS kernels and
programs, and nothing from the live session reaches the installed system by
itself. This changes the lists and adds two steps that put OziOS and its
kernel into the new system. The rules live in ozipkg/installer.py.

Does nothing where Calamares is not installed, and never fails the caller.
"""
import sys

sys.path.insert(0, "/usr/lib/ozios/python")


def main():
    try:
        from ozipkg import installer
        for path in installer.apply():
            print("patch-installer: changed " + path)
    except Exception as err:               # a package hook must never fail an update
        print("patch-installer: %s" % err, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
