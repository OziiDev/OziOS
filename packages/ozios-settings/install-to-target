#!/bin/sh
# Run by Calamares during an installation to put OziOS into the new system. It
# always exits 0, so a problem here can not fail an otherwise good install.
#
#   install-to-target kernel  right after the base system, before the driver step
#                             (chwd): a package source for the OziOS packages on the
#                             new disk, then the OziOS kernel and its headers
#   install-to-target early   after the extra packages and before the initramfs
#                             and boot loader steps: the OziOS packages, and the
#                             guest tools when installing in a virtual machine
#   install-to-target late    right before the unmount: boot menu details, VirtualBox's
#                             shared folders, the clock next to Windows
#
# The installer's package lists no longer name CachyOS kernels. The OziOS kernel
# comes from the medium; if it can not be installed the Arch kernel is, so the
# new system always has something to boot.
stage="${1:-late}"
# Where the packages are on the medium, and the new system; both can be named for a test.
src="${OZIOS_PACKAGES:-/opt/ozios}"
root="${OZIOS_TARGET:-$(findmnt -rno TARGET | grep -m1 '^/tmp/calamares-root-')}"

if [ -z "$root" ]; then
  echo "ozios: nothing to do, no installation target is mounted"
  exit 0
fi

has_kernel() {
  ls "$root"/usr/lib/modules/*/vmlinuz >/dev/null 2>&1
}

# In a virtual machine, its guest tools: the folders the host shares (for VirtualBox
# on Windows, the Windows folders), a shared clipboard, a screen that follows the
# window. The driver step (chwd) only looks at real hardware, and the installer's
# package list has none of them, so a system installed in a VM had none.
guest_tools() {
  unit=""
  case "$(systemd-detect-virt 2>/dev/null)" in
    oracle) pkgs="virtualbox-guest-utils"; unit=vboxservice.service ;;
    vmware) pkgs="open-vm-tools"; unit=vmtoolsd.service ;;
    kvm | qemu) pkgs="qemu-guest-agent spice-vdagent" ;;
    *) return 0 ;;
  esac
  # shellcheck disable=SC2086
  if arch-chroot "$root" pacman --noconfirm --needed -S $pkgs; then
    [ -z "$unit" ] || arch-chroot "$root" systemctl enable "$unit" || echo "ozios: could not enable $unit"
  else
    echo "ozios: could not install $pkgs"
  fi
}

# Is Windows on this computer? Its boot manager on the EFI partition the new
# system uses, or anything os-prober finds on the other partitions.
windows_beside() {
  for esp in "$root/boot" "$root/efi" "$root/boot/efi"; do
    [ -f "$esp/EFI/Microsoft/Boot/bootmgfw.efi" ] && return 0
  done
  command -v os-prober >/dev/null 2>&1 && os-prober 2>/dev/null | grep -qi windows
}

# arch-chroot mounts its own /tmp, so the file goes where the chroot can see it.
install_pkg() {
  mkdir -p "$root/opt/ozios" && cp -f "$1" "$root/opt/ozios/" || return 1
  arch-chroot "$root" pacman --noconfirm --needed -U "/opt/ozios/$(basename "$1")"
}

# A package source on the new system's own disk. pacman then knows the OziOS
# packages by name: the driver step asks it for "<kernel>-headers" when an NVIDIA
# card needs a module built (DKMS), and `pacman -S linux-ozios-headers` works later.
make_repo() {
  mkdir -p "$root/opt/ozios" || return 1
  cp -f "$src"/*.pkg.tar.* "$root/opt/ozios/" 2>/dev/null
  pkgs="$(cd "$root/opt/ozios" && ls ./*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | sed 's|^\./||' | tr '\n' ' ')"
  [ -n "$pkgs" ] || return 1
  arch-chroot "$root" sh -c "cd /opt/ozios && rm -f ozios.db* ozios.files* && repo-add -q ozios.db.tar.gz $pkgs" || return 1
  if ! grep -q '^\[ozios\]' "$root/etc/pacman.conf" 2>/dev/null; then
    printf '\n# OziOS packages kept on this disk by the installer.\n[ozios]\nSigLevel = Optional TrustAll\nServer = file:///opt/ozios\n' \
      >> "$root/etc/pacman.conf" || return 1
  fi
  # Only this repository's list is put in place; refreshing the others here would mix package versions.
  mkdir -p "$root/var/lib/pacman/sync" &&
    cp -f "$root/opt/ozios/ozios.db.tar.gz" "$root/var/lib/pacman/sync/ozios.db"
}

kernel() {
  make_repo || echo "ozios: could not set up the package source for the OziOS packages"
  if ! ls "$root"/usr/lib/modules/*-ozios/vmlinuz >/dev/null 2>&1; then
    # The headers too: a driver built for the kernel during the installation (NVIDIA through DKMS) needs them.
    if ! arch-chroot "$root" pacman --noconfirm --needed -S linux-ozios linux-ozios-headers; then
      # Without the package source: straight from the files.
      for name in linux-ozios linux-ozios-headers; do
        file="$(ls "$root/opt/ozios/$name"-[0-9]*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -n1)"
        [ -n "$file" ] && { arch-chroot "$root" pacman --noconfirm --needed -U "/opt/ozios/$(basename "$file")" ||
          echo "ozios: could not install $(basename "$file")"; }
      done
    fi
  fi
  # A system without a kernel does not boot.
  if ! has_kernel; then
    echo "ozios: no kernel was installed, falling back to the Arch kernel"
    arch-chroot "$root" pacman --noconfirm --needed -S linux linux-headers || echo "ozios: could not install the Arch kernel either"
  fi
}

early() {
  settings="$(ls "$src"/ozios-settings-*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -n1)"
  if [ -n "$settings" ]; then
    # Inside the new system, so its own databases and mirrors can supply what the package depends on.
    install_pkg "$settings" ||
      pacman --root "$root" --noconfirm --needed -U "$settings" ||
      echo "ozios: could not install $settings into $root"
  fi
  for edu in $(ls "$src"/ozios-edu-*.pkg.tar.* 2>/dev/null | grep -v '\.sig$'); do
    install_pkg "$edu" || echo "ozios: could not install $(basename "$edu")"
  done

  # Normally the kernel stage did this; an installer set up before that stage existed relies on this one.
  has_kernel || kernel

  guest_tools

  # The OziOS boot splash. Set before the initramfs is built, which then carries it.
  if [ -f "$root/usr/share/plymouth/themes/ozios/ozios.plymouth" ] && [ -x "$root/usr/bin/plymouth-set-default-theme" ]; then
    arch-chroot "$root" plymouth-set-default-theme ozios || echo "ozios: could not set the boot splash"
  fi

  # What the installer may still have brought along from CachyOS.
  unwanted="$(arch-chroot "$root" pacman -Qq 2>/dev/null | grep -E '^(linux-cachyos[a-z0-9.+-]*|cachyos-hello|cachyos-kernel-manager|cachyos-packageinstaller)$')"
  if [ -n "$unwanted" ] && has_kernel; then
    # shellcheck disable=SC2086
    arch-chroot "$root" pacman --noconfirm -Rdd $unwanted || echo "ozios: could not remove $unwanted"
  fi
}

late() {
  # VirtualBox hands the folders shared with the computer it runs on to the group
  # vboxsf (its guest tools, put in by the driver step, create it). In it, the
  # people of the new system can open them.
  if grep -q '^vboxsf:' "$root/etc/group" 2>/dev/null; then
    for user in $(awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' "$root/etc/passwd" 2>/dev/null); do
      arch-chroot "$root" gpasswd -a "$user" vboxsf >/dev/null || echo "ozios: could not add $user to vboxsf"
    done
  fi

  # Windows keeps the hardware clock in local time. Next to it OziOS does the same;
  # otherwise the clock is off by the time zone after every switch between the two.
  if windows_beside; then
    printf '0.0 0 0.0\n0\nLOCAL\n' > "$root/etc/adjtime" &&
      echo "ozios: Windows is on this computer, so the hardware clock keeps local time"
  fi

  # Limine: an empty group named after CachyOS, written first by the installer, would show
  # in the menu and make the default entry a group, which does not boot. The installer's
  # rewrite stops it being written; this takes it out of a configuration that has it anyway.
  for conf in "$root/boot/limine.conf" "$root/efi/limine.conf" "$root/boot/efi/limine.conf"; do
    [ -f "$conf" ] && sed -i '/^\/+CachyOS[[:space:]]*$/d' "$conf"
  done

  # The boot menu names the system and lists the OziOS kernel first.
  if [ -f "$root/boot/grub/grub.cfg" ]; then
    if [ -f "$root/etc/default/grub" ]; then
      for entry in 'GRUB_DISTRIBUTOR="OziOS"' 'GRUB_TOP_LEVEL="/boot/vmlinuz-linux-ozios"'; do
        key="${entry%%=*}"
        if grep -q "^$key=" "$root/etc/default/grub"; then
          sed -i "s|^$key=.*|$entry|" "$root/etc/default/grub"
        else
          echo "$entry" >> "$root/etc/default/grub"
        fi
      done
      [ -f "$root/usr/share/grub/themes/ozios/theme.txt" ] &&
        sed -i 's|^#\{0,1\}GRUB_THEME=.*|GRUB_THEME="/usr/share/grub/themes/ozios/theme.txt"|' "$root/etc/default/grub"
    fi
    arch-chroot "$root" grub-mkconfig -o /boot/grub/grub.cfg || echo "ozios: grub-mkconfig failed"
  elif [ -d "$root/boot/loader/entries" ] || [ -d "$root/efi/loader/entries" ]; then
    version="$(ls "$root/usr/lib/modules" | grep -- '-ozios$' | head -n1)"
    [ -n "$version" ] && command -v kernel-install >/dev/null &&
      arch-chroot "$root" kernel-install add "$version" "/usr/lib/modules/$version/vmlinuz" ||
      echo "ozios: left the boot menu as it was"
  fi
}

case "$stage" in
  kernel) kernel ;;
  early) early ;;
  late) late ;;
  *) echo "ozios: unknown stage '$stage'" ;;
esac
exit 0
