pkgname=ozios-settings
pkgver=0.1.1
pkgrel=1
pkgdesc="OziOS identity, desktop look and system tools"
arch=(any)
license=(MIT)
depends=(bash python polkit python-pyqt6 qt6-declarative podman bubblewrap pacman-contrib)
optdepends=(
  'freerdp: open Windows programs from the desktop'
  'libvirt: run the Windows guest'
  'virt-install: set up the Windows guest'
  'libisoburn: set up the Windows guest'
  'snapper: snapshots before package changes'
  'gamemode: ozi play uses it when it is installed'
  'mangohud: performance overlay for ozi play --mangohud'
)
install=ozios-settings.install
options=(!strip !debug)

# Built from a checkout rather than a tarball: iso/build.sh points OZI_SRC at it.
package() {
  local src="${OZI_SRC:?OZI_SRC must point at the OziOS source tree}"
  local here="$src/packages/ozios-settings"
  local share="$pkgdir/usr/share/ozios"

  install -Dm644 "$src/VERSION" "$share/VERSION"
  install -Dm755 "$src/packages/ozi-cli/ozi"   "$pkgdir/usr/bin/ozi"
  install -Dm755 "$src/packages/ozi-cli/ozi-pkg" "$pkgdir/usr/bin/ozi-pkg"
  install -Dm755 "$src/packages/ozi-cli/ozi-box" "$pkgdir/usr/bin/ozi-box"
  install -Dm755 "$src/packages/ozi-cli/ozi-tools" "$pkgdir/usr/bin/ozi-tools"
  install -d "$pkgdir/usr/lib/ozios/python"
  cp -r "$src/python/ozipkg" "$pkgdir/usr/lib/ozios/python/"
  find "$pkgdir/usr/lib/ozios/python" -name __pycache__ -prune -exec rm -rf {} +
  install -Dm644 "$src/data/i18n/tr.json" "$share/data/i18n/tr.json"
  install -Dm755 "$src/branding/ozi-fetch"     "$pkgdir/usr/bin/ozi-fetch"
  install -Dm755 "$src/winbridge/ozi-winrun"   "$pkgdir/usr/bin/ozi-winrun"
  install -Dm755 "$src/winbridge/ozi-winsetup" "$pkgdir/usr/bin/ozi-winsetup"
  install -Dm644 "$src/winbridge/ozi-winrun.desktop" "$pkgdir/usr/share/applications/ozi-winrun.desktop"

  install -Dm755 "$src/branding/ozi-fetch"       "$share/branding/ozi-fetch"
  install -Dm644 -t "$share/branding"            "$src/branding/OziOS.colors" "$src/branding/logo.svg" "$src/branding/wallpaper.svg"
  install -Dm644 -t "$share/branding/konsole"    "$src"/branding/konsole/*
  install -Dm755 "$src/tools/apply-branding.sh"  "$share/tools/apply-branding.sh"
  install -Dm644 -t "$share/layouts"             "$src"/desktop/layouts/*.js
  install -Dm755 "$src/vfio/detect-iommu.sh"     "$share/vfio/detect-iommu.sh"
  install -Dm644 -t "$share/winimage"            "$src/winimage/autounattend.xml" "$src/winimage/ozi-setup.ps1"

  install -Dm644 "$src/branding/OziOS.colors" "$pkgdir/usr/share/color-schemes/OziOS.colors"
  install -Dm644 -t "$pkgdir/usr/share/konsole" "$src"/branding/konsole/*
  install -Dm644 "$src/branding/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ozios.svg"

  local wallpaper=org.ozios.tesseract
  install -Dm644 "$src/desktop/wallpaper/$wallpaper/metadata.json" \
    "$pkgdir/usr/share/plasma/wallpapers/$wallpaper/metadata.json"
  install -Dm644 -t "$pkgdir/usr/share/plasma/wallpapers/$wallpaper/contents/ui" \
    "$src/desktop/wallpaper/$wallpaper"/contents/ui/*.qml

  local control=org.ozios.control
  install -Dm644 "$src/desktop/plasmoids/$control/metadata.json" "$pkgdir/usr/share/plasma/plasmoids/$control/metadata.json"
  install -Dm644 "$src/desktop/plasmoids/$control/contents/ui/main.qml" "$pkgdir/usr/share/plasma/plasmoids/$control/contents/ui/main.qml"

  # Global theme: colours, panel layout, splash. The splash reuses the
  # wallpaper's figure, so that one file is installed into both.
  local theme="$pkgdir/usr/share/plasma/look-and-feel/org.ozios.desktop"
  local theme_src="$src/desktop/look-and-feel/org.ozios.desktop"
  install -Dm644 "$theme_src/metadata.json" "$theme/metadata.json"
  install -Dm644 "$theme_src/contents/defaults" "$theme/contents/defaults"
  install -Dm644 -t "$theme/contents/layouts" "$theme_src"/contents/layouts/*.js
  install -Dm644 -t "$theme/contents/splash" "$theme_src/contents/splash/Splash.qml" \
    "$src/desktop/wallpaper/$wallpaper/contents/ui/Tesseract.qml"

  # The installer's look, and the boot menu and boot loader splash.
  local branding="$pkgdir/usr/share/calamares/branding/ozios"
  install -Dm644 -t "$branding" "$src"/branding/calamares/ozios/{logo.png,icon.png,welcome.png,show.qml}
  sed "s/@VERSION@/$pkgver/g" "$src/branding/calamares/ozios/branding.desc" > "$srcdir/branding.desc"
  install -Dm644 "$srcdir/branding.desc" "$branding/branding.desc"
  install -Dm644 "$src/branding/boot/theme.txt" "$pkgdir/usr/share/grub/themes/ozios/theme.txt"
  install -Dm644 "$src/branding/boot/background.png" "$pkgdir/usr/share/grub/themes/ozios/background.png"
  install -Dm644 "$src/branding/boot/limine-splash.png" "$share/branding/limine-splash.png"
  install -Dm644 "$src/branding/boot/desktop.png" "$share/branding/desktop.png"

  # Completions for the shells people use.
  local comp="$src/data/completions"
  install -Dm644 "$comp/ozi.bash"     "$pkgdir/usr/share/bash-completion/completions/ozi"
  install -Dm644 "$comp/ozi-pkg.bash" "$pkgdir/usr/share/bash-completion/completions/ozi-pkg"
  install -Dm644 "$comp/ozi.fish"     "$pkgdir/usr/share/fish/vendor_completions.d/ozi.fish"
  install -Dm644 "$comp/ozi-pkg.fish" "$pkgdir/usr/share/fish/vendor_completions.d/ozi-pkg.fish"
  install -Dm644 "$comp/_ozi"         "$pkgdir/usr/share/zsh/site-functions/_ozi"
  install -Dm644 "$comp/_ozi-pkg"     "$pkgdir/usr/share/zsh/site-functions/_ozi-pkg"

  install -Dm755 -t "$pkgdir/usr/lib/ozios" "$here/identity" "$here/patch-installer" "$here/install-to-target" "$here/ozi-pkg-helper" "$here/first-login" "$here/start-installer"
  install -Dm644 "$here/org.ozios.pkg.manage.policy" "$pkgdir/usr/share/polkit-1/actions/org.ozios.pkg.manage.policy"
  # Graphical apps: Software and Welcome, sharing the OziUi components.
  local apps="$pkgdir/usr/lib/ozios/apps"
  install -Dm644 "$src/apps/ozi_qt.py" "$apps/ozi_qt.py"
  install -Dm644 -t "$apps/OziUi" "$src"/apps/OziUi/*
  install -Dm755 "$src/apps/ozi-store/ozi-store" "$apps/ozi-store/ozi-store"
  install -Dm644 "$src/apps/ozi-store/Main.qml" "$apps/ozi-store/Main.qml"
  install -Dm755 "$src/apps/ozi-welcome/ozi-welcome" "$apps/ozi-welcome/ozi-welcome"
  install -Dm644 "$src/apps/ozi-welcome/Main.qml" "$apps/ozi-welcome/Main.qml"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/ozios/apps/ozi-store/ozi-store "$pkgdir/usr/bin/ozi-store"
  ln -s /usr/lib/ozios/apps/ozi-welcome/ozi-welcome "$pkgdir/usr/bin/ozi-welcome"
  install -Dm644 "$src/apps/ozi-store.desktop" "$pkgdir/usr/share/applications/ozi-store.desktop"
  install -Dm644 "$src/apps/ozi-welcome.desktop" "$pkgdir/usr/share/applications/ozi-welcome.desktop"
  install -Dm644 "$src/apps/ozi-welcome-autostart.desktop" "$pkgdir/etc/xdg/autostart/ozi-welcome.desktop"
  # Named to sort after the CachyOS hook that writes os-release, so ours has the last word.
  install -Dm644 "$here/zz-ozios.hook" "$pkgdir/usr/share/libalpm/hooks/zz-ozios.hook"
  install -Dm644 "$here/first-login.desktop" "$pkgdir/etc/xdg/autostart/ozios-first-login.desktop"
}
