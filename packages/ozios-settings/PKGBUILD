pkgname=ozios-settings
pkgver=0.3.0
pkgrel=2
pkgdesc="OziOS identity, desktop look and system tools"
arch=(any)
license=(MIT)
depends=(bash python polkit python-pyqt6 qt6-declarative podman bubblewrap pacman-contrib ttf-overpass kdialog)
optdepends=(
  'freerdp: open Windows programs from the desktop'
  'libvirt: run the Windows guest'
  'virt-install: set up the Windows guest'
  'libisoburn: set up the Windows guest'
  'snapper: snapshots before package changes'
  'gamemode: ozi play uses it when it is installed'
  'mangohud: performance overlay for ozi play --mangohud'
)
install=ozios-settings.install
options=(!strip !debug)

# Built from a checkout rather than a tarball: iso/build.sh points OZI_SRC at it.
package() {
  local src="${OZI_SRC:?OZI_SRC must point at the OziOS source tree}"
  local here="$src/packages/ozios-settings"
  local share="$pkgdir/usr/share/ozios"

  install -Dm644 "$src/VERSION" "$share/VERSION"
  install -Dm755 "$src/packages/ozi-cli/ozi"   "$pkgdir/usr/bin/ozi"
  install -Dm755 "$src/packages/ozi-cli/ozi-pkg" "$pkgdir/usr/bin/ozi-pkg"
  install -Dm755 "$src/packages/ozi-cli/ozi-box" "$pkgdir/usr/bin/ozi-box"
  install -Dm755 "$src/packages/ozi-cli/ozi-tools" "$pkgdir/usr/bin/ozi-tools"
  install -d "$pkgdir/usr/lib/ozios/python"
  cp -r "$src/python/ozipkg" "$pkgdir/usr/lib/ozios/python/"
  find "$pkgdir/usr/lib/ozios/python" -name __pycache__ -prune -exec rm -rf {} +
  # cp keeps the source's modes; from a VirtualBox shared folder those are rwxrwx---.
  chmod -R u=rwX,go=rX "$pkgdir/usr/lib/ozios/python"
  install -Dm644 "$src/data/i18n/tr.json" "$share/data/i18n/tr.json"
  install -Dm755 "$src/branding/ozi-fetch"     "$pkgdir/usr/bin/ozi-fetch"
  install -Dm755 "$src/winbridge/ozi-winrun"   "$pkgdir/usr/bin/ozi-winrun"
  install -Dm755 "$src/winbridge/ozi-winsetup" "$pkgdir/usr/bin/ozi-winsetup"
  install -Dm644 "$src/winbridge/ozi-winrun.desktop" "$pkgdir/usr/share/applications/ozi-winrun.desktop"

  install -Dm755 "$src/branding/ozi-fetch"       "$share/branding/ozi-fetch"
  install -Dm644 -t "$share/branding"            "$src/branding/OziOS.colors" "$src/branding/logo.svg" "$src/branding/wallpaper.svg"
  install -Dm644 -t "$share/branding/konsole"    "$src"/branding/konsole/*
  install -Dm755 "$src/tools/apply-branding.sh"  "$share/tools/apply-branding.sh"
  install -Dm644 -t "$share/layouts"             "$src"/desktop/layouts/*.js
  install -Dm755 "$src/vfio/detect-iommu.sh"     "$share/vfio/detect-iommu.sh"
  install -Dm644 -t "$share/winimage"            "$src/winimage/autounattend.xml" "$src/winimage/ozi-setup.ps1"

  install -Dm644 "$src/branding/OziOS.colors" "$pkgdir/usr/share/color-schemes/OziOS.colors"
  install -Dm644 -t "$pkgdir/usr/share/konsole" "$src"/branding/konsole/*
  install -Dm644 "$src/branding/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ozios.svg"

  local wallpaper=org.ozios.tesseract
  install -Dm644 "$src/desktop/wallpaper/$wallpaper/metadata.json" \
    "$pkgdir/usr/share/plasma/wallpapers/$wallpaper/metadata.json"
  install -Dm644 -t "$pkgdir/usr/share/plasma/wallpapers/$wallpaper/contents/ui" \
    "$src/desktop/wallpaper/$wallpaper"/contents/ui/*.qml
  install -Dm644 -t "$pkgdir/usr/share/plasma/wallpapers/$wallpaper/contents/config" \
    "$src/desktop/wallpaper/$wallpaper"/contents/config/main.xml

  # The widgets with no settings of their own: the control centre, and the desktops
  # and the clock in the islands at the top.
  local applet file
  for applet in org.ozios.control org.ozios.workspaces org.ozios.clock; do
    install -Dm644 "$src/desktop/plasmoids/$applet/metadata.json" "$pkgdir/usr/share/plasma/plasmoids/$applet/metadata.json"
    install -Dm644 -t "$pkgdir/usr/share/plasma/plasmoids/$applet/contents/ui" "$src/desktop/plasmoids/$applet"/contents/ui/*.qml
  done

  # The OziOS shell: the dock and the launcher, the Plasma style their frames are
  # drawn with, the window motion, and the colour themes all of it follows.
  for applet in org.ozios.dock org.ozios.launcher; do
    install -Dm644 "$src/desktop/plasmoids/$applet/metadata.json" "$pkgdir/usr/share/plasma/plasmoids/$applet/metadata.json"
    install -Dm644 -t "$pkgdir/usr/share/plasma/plasmoids/$applet/contents/config" "$src/desktop/plasmoids/$applet"/contents/config/main.xml
    install -Dm644 -t "$pkgdir/usr/share/plasma/plasmoids/$applet/contents/ui" "$src/desktop/plasmoids/$applet"/contents/ui/*.qml
  done
  while IFS= read -r file; do
    install -Dm644 "$src/desktop/plasma-style/ozios/$file" "$pkgdir/usr/share/plasma/desktoptheme/ozios/$file"
  done < <(cd "$src/desktop/plasma-style/ozios" && find . -type f -printf '%P\n')
  # Windows opening and closing, flowing to a new place or size, and minimising into the dock.
  local effect
  for effect in ozios_motion ozios_morph ozios_minimize; do
    install -Dm644 "$src/desktop/kwin/effects/$effect/metadata.json" "$pkgdir/usr/share/kwin-wayland/effects/$effect/metadata.json"
    install -Dm644 "$src/desktop/kwin/effects/$effect/contents/code/main.js" \
      "$pkgdir/usr/share/kwin-wayland/effects/$effect/contents/code/main.js"
  done
  # Tiling on Meta+T, a desktop at a time.
  install -Dm644 "$src/desktop/kwin/scripts/ozios-tiling/metadata.json" "$pkgdir/usr/share/kwin-wayland/scripts/ozios-tiling/metadata.json"
  install -Dm644 "$src/desktop/kwin/scripts/ozios-tiling/contents/code/main.js" \
    "$pkgdir/usr/share/kwin-wayland/scripts/ozios-tiling/contents/code/main.js"
  install -Dm644 -t "$pkgdir/usr/share/color-schemes" "$src"/branding/themes/*.colors
  local switcher="$pkgdir/usr/share/kwin-wayland/tabbox/org.ozios.switcher"
  install -Dm644 "$src/desktop/kwin/tabbox/org.ozios.switcher/metadata.json" "$switcher/metadata.json"
  install -Dm644 -t "$switcher/contents/ui" "$src"/desktop/kwin/tabbox/org.ozios.switcher/contents/ui/*.qml

  # Global theme: colours, panel layout, splash, and the screen to lock, sleep,
  # restart, shut down or log out. The splash reuses the wallpaper's figure,
  # so that one file is installed into both.
  local theme="$pkgdir/usr/share/plasma/look-and-feel/org.ozios.desktop"
  local theme_src="$src/desktop/look-and-feel/org.ozios.desktop"
  install -Dm644 "$theme_src/metadata.json" "$theme/metadata.json"
  install -Dm644 "$theme_src/contents/defaults" "$theme/contents/defaults"
  install -Dm644 -t "$theme/contents/layouts" "$theme_src"/contents/layouts/*.js
  install -Dm644 -t "$theme/contents/logout" "$theme_src"/contents/logout/*.qml "$theme_src/contents/logout/keys.js"
  # From Plasma 6.8 on the logout greeter takes that screen from a shell package: this one
  # holds only it, and everything else falls back to Plasma's own shell. apply-branding.sh
  # points the greeter, and only the greeter, at it.
  local shell="$pkgdir/usr/share/plasma/shells/org.ozios.desktop"
  install -Dm644 "$src/desktop/shell/org.ozios.desktop/metadata.json" "$shell/metadata.json"
  install -Dm644 -t "$shell/contents/logout" "$theme_src"/contents/logout/*.qml "$theme_src/contents/logout/keys.js"
  install -Dm644 -t "$theme/contents/splash" "$theme_src/contents/splash/Splash.qml" \
    "$src/desktop/wallpaper/$wallpaper/contents/ui/Tesseract.qml"

  # The installer's look, and the boot menu and boot loader splash.
  local branding="$pkgdir/usr/share/calamares/branding/ozios"
  install -Dm644 -t "$branding" "$src"/branding/calamares/ozios/{logo.png,icon.png,welcome.png,show.qml,OziSlide.qml}
  sed "s/@VERSION@/$pkgver/g" "$src/branding/calamares/ozios/branding.desc" > "$srcdir/branding.desc"
  install -Dm644 "$srcdir/branding.desc" "$branding/branding.desc"
  install -Dm644 "$src/branding/boot/theme.txt" "$pkgdir/usr/share/grub/themes/ozios/theme.txt"
  install -Dm644 "$src/branding/boot/background.png" "$pkgdir/usr/share/grub/themes/ozios/background.png"
  install -Dm644 "$src/branding/boot/limine-splash.png" "$share/branding/limine-splash.png"
  install -Dm644 "$src/branding/boot/desktop.png" "$share/branding/desktop.png"
  # The boot splash: Plymouth's two-step plugin with the turning tesseract (tools/make-plymouth.py).
  install -Dm644 -t "$pkgdir/usr/share/plymouth/themes/ozios" "$src"/branding/plymouth/ozios/*

  install -Dm644 "$src/branding/login/10-ozios.conf" "$pkgdir/etc/plasmalogin.conf.d/10-ozios.conf"
  # Defaults for every user, which each person can still change: file search without content
  # indexing, the OziOS splash already before the first login has set the OziOS look, and the
  # OziOS figure on the lock screen.
  install -Dm644 "$src/desktop/defaults/baloofilerc" "$pkgdir/etc/xdg/baloofilerc"
  install -Dm644 "$src/desktop/defaults/ksplashrc" "$pkgdir/etc/xdg/ksplashrc"
  install -Dm644 "$src/desktop/defaults/kscreenlockerrc" "$pkgdir/etc/xdg/kscreenlockerrc"

  install -Dm644 "$src/docs/man/ozi.1"     "$pkgdir/usr/share/man/man1/ozi.1"
  install -Dm644 "$src/docs/man/ozi-pkg.1" "$pkgdir/usr/share/man/man1/ozi-pkg.1"

  # Completions for the shells people use.
  local comp="$src/data/completions"
  install -Dm644 "$comp/ozi.bash"     "$pkgdir/usr/share/bash-completion/completions/ozi"
  install -Dm644 "$comp/ozi-pkg.bash" "$pkgdir/usr/share/bash-completion/completions/ozi-pkg"
  install -Dm644 "$comp/ozi.fish"     "$pkgdir/usr/share/fish/vendor_completions.d/ozi.fish"
  install -Dm644 "$comp/ozi-pkg.fish" "$pkgdir/usr/share/fish/vendor_completions.d/ozi-pkg.fish"
  install -Dm644 "$comp/_ozi"         "$pkgdir/usr/share/zsh/site-functions/_ozi"
  install -Dm644 "$comp/_ozi-pkg"     "$pkgdir/usr/share/zsh/site-functions/_ozi-pkg"

  install -Dm755 -t "$pkgdir/usr/lib/ozios" "$here/identity" "$here/patch-installer" "$here/install-to-target" "$here/ozi-pkg-helper" "$here/first-login" "$here/start-installer" "$here/tidy-menu" "$here/retry-download"
  # Developer and test tools stay installed but out of the program menu.
  install -Dm644 "$here/zz-ozios-menu.hook" "$pkgdir/usr/share/libalpm/hooks/zz-ozios-menu.hook"
  # Window animations also where KWin draws in software (a virtual machine without 3D).
  install -Dm644 "$here/60-ozios-animations.conf" "$pkgdir/usr/lib/environment.d/60-ozios-animations.conf"
  install -Dm644 "$here/org.ozios.pkg.manage.policy" "$pkgdir/usr/share/polkit-1/actions/org.ozios.pkg.manage.policy"
  # Graphical apps: Software, Welcome and Look, sharing the OziUi components.
  local apps="$pkgdir/usr/lib/ozios/apps"
  install -Dm644 "$src/apps/ozi_qt.py" "$apps/ozi_qt.py"
  install -Dm644 -t "$apps/OziUi" "$src"/apps/OziUi/*
  install -Dm755 "$src/apps/ozi-store/ozi-store" "$apps/ozi-store/ozi-store"
  install -Dm644 "$src/apps/ozi-store/Main.qml" "$apps/ozi-store/Main.qml"
  install -Dm755 "$src/apps/ozi-welcome/ozi-welcome" "$apps/ozi-welcome/ozi-welcome"
  install -Dm644 "$src/apps/ozi-welcome/Main.qml" "$apps/ozi-welcome/Main.qml"
  install -Dm755 "$src/apps/ozi-look/ozi-look" "$apps/ozi-look/ozi-look"
  install -Dm644 "$src/apps/ozi-look/Main.qml" "$apps/ozi-look/Main.qml"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/ozios/apps/ozi-store/ozi-store "$pkgdir/usr/bin/ozi-store"
  ln -s /usr/lib/ozios/apps/ozi-welcome/ozi-welcome "$pkgdir/usr/bin/ozi-welcome"
  ln -s /usr/lib/ozios/apps/ozi-look/ozi-look "$pkgdir/usr/bin/ozi-look"
  install -Dm644 "$src/apps/ozi-store.desktop" "$pkgdir/usr/share/applications/ozi-store.desktop"
  install -Dm644 "$src/apps/ozi-welcome.desktop" "$pkgdir/usr/share/applications/ozi-welcome.desktop"
  # Look, and the card of keys that Meta+K opens.
  install -Dm644 "$src/apps/ozi-look.desktop" "$pkgdir/usr/share/applications/ozi-look.desktop"
  install -Dm644 "$src/apps/ozi-keys.desktop" "$pkgdir/usr/share/applications/ozi-keys.desktop"
  install -Dm644 "$src/apps/ozi-welcome-autostart.desktop" "$pkgdir/etc/xdg/autostart/ozi-welcome.desktop"
  # Named to sort after the CachyOS hook that writes os-release, so ours has the last word.
  install -Dm644 "$here/zz-ozios.hook" "$pkgdir/usr/share/libalpm/hooks/zz-ozios.hook"
  install -Dm644 "$here/first-login.desktop" "$pkgdir/etc/xdg/autostart/ozios-first-login.desktop"
  # `ozi theme auto`: day and night colours, switched by a timer of the user's own session.
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$here/ozios-theme-auto.service" "$here/ozios-theme-auto.timer"
}
