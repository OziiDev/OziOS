#!/bin/sh
# os-release is not ours to ship, so it is rewritten in place, again after
# every update that touches it. ID stays as it is: CachyOS tools look at it
# to decide whether they are on a supported system.
version="$(tr -d '[:space:]' < /usr/share/ozios/VERSION 2>/dev/null)"
for file in /etc/os-release /usr/lib/os-release; do
  [ -f "$file" ] || continue
  if [ -n "$version" ]; then
    # One line of our own; the standard VERSION fields stay as the base system has them.
    sed -i --follow-symlinks '/^OZIOS_VERSION=/d' "$file"
    echo "OZIOS_VERSION=$version" >> "$file"
  fi
  sed -i --follow-symlinks \
    -e 's/^NAME=.*/NAME="OziOS"/' \
    -e 's/^PRETTY_NAME=.*/PRETTY_NAME="OziOS"/' \
    -e 's/^LOGO=.*/LOGO=ozios/' \
    -e 's/^ANSI_COLOR=.*/ANSI_COLOR="38;2;0;229;255"/' \
    -e 's|^HOME_URL=.*|HOME_URL="https://github.com/OziiDev/OziOS"|' \
    -e 's|^DOCUMENTATION_URL=.*|DOCUMENTATION_URL="https://github.com/OziiDev/OziOS/tree/main/docs"|' \
    -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/OziiDev/OziOS/issues"|' \
    -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/OziiDev/OziOS/issues"|' \
    "$file"
  # The name a machine gets when nothing has set one.
  sed -i --follow-symlinks '/^DEFAULT_HOSTNAME=/d' "$file"
  echo 'DEFAULT_HOSTNAME=ozios' >> "$file"
  # An edition is named in os-release; the file is written by the edition's package.
  sed -i --follow-symlinks '/^VARIANT=/d;/^VARIANT_ID=/d' "$file"
  edition="$(tr -d '[:space:]' < /usr/share/ozios/edition 2>/dev/null)"
  if [ "$edition" = edu ]; then
    echo 'VARIANT="Education"' >> "$file"
    echo 'VARIANT_ID=edu' >> "$file"
  fi
done
[ ! -f /etc/lsb-release ] || sed -i --follow-symlinks \
  -e 's/^DISTRIB_ID=.*/DISTRIB_ID=OziOS/' -e 's/^DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION="OziOS"/' /etc/lsb-release

# OziOS has its own welcome app. The CachyOS one is started from the skeleton
# for every new user (and from the live user's home), so hide it at the source.
for file in /etc/skel/.config/autostart/cachyos-hello.desktop /home/liveuser/.config/autostart/cachyos-hello.desktop; do
  [ -f "$file" ] || continue
  grep -q '^Hidden=true' "$file" && continue
  sed -i '/^Hidden=/d' "$file"
  sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nHidden=true/' "$file"
done
exit 0
