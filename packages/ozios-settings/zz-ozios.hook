[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/os-release
Target = etc/calamares/*
Target = usr/share/calamares/*
Target = etc/skel/.config/autostart/cachyos-hello.desktop

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = ozios-settings
Target = ozios-edu

[Action]
Description = Applying OziOS identity...
When = PostTransaction
Exec = /bin/sh -c '/usr/lib/ozios/identity; /usr/lib/ozios/patch-installer'
