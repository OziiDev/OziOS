#!/bin/bash
# Run by pacman after Plasma's decoration library (kdecoration) or ozios-decoration
# changes: are the OziOS window frames built for this Plasma?
#
# A decoration plugin built against another feature release of KDecoration3 can take
# KWin down with it, so the plugin KWin finds must be built for the Plasma installed:
# the package's own, when it was built for this Plasma, or else one built here by
# decoration-rebuild from the source that comes with the package. The package's plugin
# then waits aside, for a Plasma that goes back to its release. When nothing fits and
# nothing can be built, there is no OziOS plugin where KWin looks and windows get
# Breeze frames. Run by hand (sudo) it does the same: after cmake is installed, say.
#
#   decoration-guard [root]     root: a system mounted elsewhere, for tests
set -u
root="${1:-}"
plugin="$root/usr/lib/qt6/plugins/org.kde.kdecoration3/org.ozios.decoration.so"
aside="$root/usr/lib/ozios/decoration-aside/org.ozios.decoration.so"
here="$root/var/lib/ozios/decoration-built-here"     # the Plasma it was built for, then its checksum
rebuild="${OZI_DECORATION_REBUILD:-$root/usr/lib/ozios/decoration-rebuild}"
packaged="$(cat "$root/usr/share/ozios/decoration-built-with" 2>/dev/null)"
now="${OZI_KDECORATION_VERSION:-$(pacman -Q --root "${root:-/}" kdecoration 2>/dev/null | awk '{ print $2 }')}"

series() {  # series 1:6.7.4-1 -> 6.7: the feature release, which is what the plugin depends on
  echo "$1" | sed -E 's/^([0-9]+:)?([0-9]+\.[0-9]+).*/\2/'
}
checksum() {
  sha256sum "$1" 2>/dev/null | cut -d' ' -f1
}

[ -n "$packaged" ] && [ -n "$now" ] || exit 0
want="$(series "$now")"

# What KWin finds: a plugin built here (its checksum is on record), or the package's.
found=""
if [ -f "$plugin" ]; then
  if [ -f "$here" ] && [ "$(sed -n 2p "$here")" = "$(checksum "$plugin")" ]; then
    found="$(series "$(sed -n 1p "$here")")"
  else
    rm -f "$here"                      # pacman has put the package's plugin back since
    found="$(series "$packaged")"
  fi
fi

if [ "$found" = "$want" ]; then
  # With the package's own plugin in place, a copy aside is of no use any more.
  [ -f "$here" ] || rm -f "$aside"
  exit 0
fi

# Plasma went back to the release the package was built for: its plugin returns.
if [ "$(series "$packaged")" = "$want" ] && [ -f "$aside" ]; then
  mv -f "$aside" "$plugin" && rm -f "$here" && echo "OziOS: the window frames fit Plasma $want again."
  exit 0
fi

# Nothing in place fits this Plasma. The package's plugin goes aside, a build of
# another day goes away, and one is built for this Plasma.
if [ -f "$plugin" ] && [ ! -f "$here" ]; then
  mkdir -p "$(dirname "$aside")" && mv -f "$plugin" "$aside"
fi
rm -f "$plugin" "$here"
if [ -f "$rebuild" ]; then
  echo "OziOS: building the window frames for Plasma $want, which takes a minute or two..."
  if bash "$rebuild" && [ -f "$plugin" ]; then
    mkdir -p "$(dirname "$here")"
    printf '%s\n%s\n' "$now" "$(checksum "$plugin")" > "$here"
    echo "OziOS: the window frames are built for Plasma $want."
    exit 0
  fi
  rm -f "$plugin"
fi
echo "OziOS: the window frames were built for Plasma $(series "$packaged") and this is Plasma $want;"
echo "       until they are built for it (sudo /usr/lib/ozios/decoration-guard), windows have Breeze frames."
exit 0
