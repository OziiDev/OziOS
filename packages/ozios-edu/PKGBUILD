pkgname=ozios-edu
pkgver=0.3.0
pkgrel=3
pkgdesc="OziOS Education: smart board desktop, screen pen and school defaults"
arch=(any)
license=(MIT)
depends=(ozios-settings ozi-desktop xournalpp gnome-calculator
         libreoffice-still libreoffice-still-tr qrencode rsync polkit)
install=ozios-edu.install
options=(!strip !debug)

# Built from a checkout, like ozios-settings: OZI_SRC points at it.
package() {
  local src="${OZI_SRC:?OZI_SRC must point at the OziOS source tree}"
  local share="$pkgdir/usr/share/ozios"

  echo edu > "$srcdir/edition"
  install -Dm644 "$srcdir/edition" "$share/edition"
  # The board's desktop: no lock, the school programs on the dock, the
  # on-screen keyboard (oziwm and ozi-shell read these under the user's own).
  install -Dm644 "$src/edu/desktop-defaults.json" "$share/desktop-defaults.json"
  install -Dm644 "$src/edu/50-ozios-edu-logind.conf" "$pkgdir/usr/lib/systemd/logind.conf.d/50-ozios-edu.conf"
  install -Dm644 -t "$pkgdir/usr/share/applications" "$src"/edu/applications/*.desktop

  # The screen pen.
  local apps="$pkgdir/usr/lib/ozios/apps"
  install -Dm755 "$src/apps/ozi-pen/ozi-pen" "$apps/ozi-pen/ozi-pen"
  install -Dm644 "$src/apps/ozi-pen/Main.qml" "$apps/ozi-pen/Main.qml"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/ozios/apps/ozi-pen/ozi-pen "$pkgdir/usr/bin/ozi-pen"
  install -Dm644 "$src/apps/ozi-pen.desktop" "$pkgdir/usr/share/applications/ozi-pen.desktop"

  # Classroom: picking a student, groups, a timer.
  install -Dm755 "$src/apps/ozi-classroom/ozi-classroom" "$apps/ozi-classroom/ozi-classroom"
  install -Dm644 "$src/apps/ozi-classroom/Main.qml" "$apps/ozi-classroom/Main.qml"
  ln -s /usr/lib/ozios/apps/ozi-classroom/ozi-classroom "$pkgdir/usr/bin/ozi-classroom"
  install -Dm644 "$src/apps/ozi-classroom.desktop" "$pkgdir/usr/share/applications/ozi-classroom.desktop"

  # Tahta Köprüsü: phones as the board's remote, the lesson's notes for the class.
  install -Dm755 "$src/apps/ozi-bridge/ozi-bridge" "$apps/ozi-bridge/ozi-bridge"
  install -Dm644 "$src/apps/ozi-bridge/Main.qml" "$apps/ozi-bridge/Main.qml"
  ln -s /usr/lib/ozios/apps/ozi-bridge/ozi-bridge "$pkgdir/usr/bin/ozi-bridge"
  install -Dm644 "$src/apps/ozi-bridge.desktop" "$pkgdir/usr/share/applications/ozi-bridge.desktop"
  install -Dm644 "$src/apps/ozi-bridge/ozi-bridge.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ozi-bridge.svg"
  # ufw is closed to incoming connections: open the bridge's ports to the local network.
  install -Dm755 "$src/edu/firewall/ozi-bridge-firewall" "$pkgdir/usr/lib/ozios/ozi-bridge-firewall"
  install -Dm644 "$src/edu/firewall/ozi-bridge-firewall.service" "$pkgdir/usr/lib/systemd/system/ozi-bridge-firewall.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../ozi-bridge-firewall.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/ozi-bridge-firewall.service"

  # Kısıtlı / Yetkili and Dondurma: the teacher's app, its root helper (pkexec,
  # no password prompt: it checks the teacher's password itself), the polkit
  # rule that refuses admin actions on a restricted board, and the start-up
  # service that puts a frozen home folder back.
  install -Dm755 "$src/apps/ozi-mode/ozi-mode" "$apps/ozi-mode/ozi-mode"
  install -Dm644 "$src/apps/ozi-mode/Main.qml" "$apps/ozi-mode/Main.qml"
  ln -s /usr/lib/ozios/apps/ozi-mode/ozi-mode "$pkgdir/usr/bin/ozi-mode"
  install -Dm644 "$src/apps/ozi-mode.desktop" "$pkgdir/usr/share/applications/ozi-mode.desktop"
  install -Dm644 "$src/apps/ozi-mode/ozi-mode.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ozi-mode.svg"
  install -Dm755 "$src/edu/mode/ozi-mode-helper" "$pkgdir/usr/lib/ozios/ozi-mode-helper"
  install -Dm755 "$src/edu/mode/ozi-mode-allowed" "$pkgdir/usr/lib/ozios/ozi-mode-allowed"
  install -Dm644 "$src/edu/mode/org.ozios.mode.policy" "$pkgdir/usr/share/polkit-1/actions/org.ozios.mode.policy"
  install -Dm644 "$src/edu/mode/50-ozios-kisitli.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-ozios-kisitli.rules"
  install -Dm644 "$src/edu/mode/ozi-freeze.service" "$pkgdir/usr/lib/systemd/system/ozi-freeze.service"
  ln -s ../ozi-freeze.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/ozi-freeze.service"
}
