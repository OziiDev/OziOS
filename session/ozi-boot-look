#!/usr/bin/python3
# The boot menu follows the desktop look; see python/ozipkg/bootlook.py.
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for root in (os.path.join(here, "..", "python"), "/usr/lib/ozios/python"):
    if os.path.isdir(os.path.join(root, "ozipkg")):
        sys.path.insert(0, root)
        break

from ozipkg import bootlook  # noqa: E402

sys.exit(bootlook.main(sys.argv[1:]))
