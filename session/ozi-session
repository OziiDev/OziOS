#!/bin/sh
# Start an OziOS desktop session (what the login screen runs for "OziOS").
# "OziOS:KDE": the programs are KDE's (and Electron's), and they pick their
# password store, portals and integration from this. An Electron app started in 3 s
# instead of 4-7 s and finds the logins it saved in KWallet under Plasma.
export XDG_CURRENT_DESKTOP=OziOS:KDE
export XDG_SESSION_DESKTOP=OziOS
export KDE_SESSION_VERSION=6
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export SDL_VIDEODRIVER="wayland,x11"
export XCURSOR_THEME="${XCURSOR_THEME:-breeze_cursors}"
# A bigger pointer on smart boards (the Education edition).
if [ -z "${XCURSOR_SIZE:-}" ] && [ "$(cat /usr/share/ozios/edition 2>/dev/null)" = edu ]; then
    XCURSOR_SIZE=36
fi
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
# KDE programs keep their own look when Plasma's Qt integration is installed.
if [ -e /usr/lib/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme6.so ]; then
    export QT_QPA_PLATFORMTHEME=kde
fi

# tools/ozi-dev-session sets these to run a checkout instead of the package.
oziwm="${OZIWM_BIN:-oziwm}"
start="${OZI_SESSION_START:-/usr/lib/ozios/ozi-session-start}"

state="${XDG_STATE_HOME:-$HOME/.local/state}/oziwm"
mkdir -p "$state"
[ -f "$state/oziwm.log" ] && mv -f "$state/oziwm.log" "$state/oziwm.previous.log"
[ -f "$state/shell.log" ] && mv -f "$state/shell.log" "$state/shell.previous.log"
exec "$oziwm" --tty -c "$start" > "$state/oziwm.log" 2>&1
