    def openSettings(self, module):
        """A page of KDE's System Settings for what the quick panel does not cover."""
        argv = ["systemsettings", module] if module else ["systemsettings"]
        try:
            subprocess.Popen(argv, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    @pyqtSlot(int)
    def setVolume(self, percent):
        threading.Thread(target=lambda: self._statusReady.emit(dict(self._status, volume=shell.set_volume(percent))),
                         daemon=True).start()

    @pyqtSlot()
    def toggleMute(self):
        threading.Thread(target=lambda: self._statusReady.emit(dict(self._status, volume=shell.toggle_mute())),
                         daemon=True).start()

