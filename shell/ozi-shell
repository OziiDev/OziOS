    @pyqtSlot(str, result=str)
    def tr(self, text):
        """The text in the session language (data/i18n), English when there is none."""
        return i18n.tr(text)

    @pyqtSlot(str, "QVariantMap", result=str)
    def trf(self, text, values):
        """tr() with {names} filled in."""
        return i18n.tr(text, **{k: str(v) for k, v in values.items()})

    @pyqtProperty(str, constant=True)
    def locale(self):
        return i18n.locale_name()

    @pyqtSlot(QObject, "QVariantList")
    def setInputRegion(self, window, rects):
        """Only these parts of a shell window take the pointer; the rest lets it
        through to what is below. Flat list: x, y, w, h, x, y, w, h... Empty: all of it."""
        region = QRegion()
        for i in range(0, len(rects) - 3, 4):
            x, y, w, h = (round(float(v)) for v in rects[i:i + 4])
            if w > 0 and h > 0:
                region = region.united(QRegion(x, y, w, h))
        try:
            window.setMask(region)
        except AttributeError:
            pass

    @pyqtSlot(int)
    def forgetClip(self, index):
        ask({"do": "clipboard-remove", "index": index} if index >= 0 else {"do": "clipboard-remove"})

    @pyqtSlot(int, int, int, int, result=str)
    def saveArea(self, x, y, w, h):
        """Save part of the screen to Pictures (and the clipboard); its path, or ""."""
        import tempfile
        from PyQt6.QtGui import QImage
        if w < 4 or h < 4:
            return ""
        tmp = os.path.join(tempfile.gettempdir(), "ozi-area-%d.png" % os.getpid())
        if ask({"do": "screenshot", "path": tmp}, timeout=5.0) is None and not os.path.exists(tmp):
            return ""
        image = QImage(tmp)
        try:
            os.remove(tmp)
        except OSError:
            pass
        if image.isNull():
            return ""
        # The screenshot is in device pixels; the selection in logical ones.
        scale = image.width() / max(1, self._screen_width())
        part = image.copy(round(x * scale), round(y * scale), round(w * scale), round(h * scale))
        path = shell.screenshot_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if not part.save(path, "PNG"):
            return ""
        QGuiApplication.clipboard().setImage(part)
        try:
            subprocess.Popen(["notify-send", "-a", "OziOS", "-i", path, i18n.tr("Screenshot taken"),
                              i18n.tr("Saved in Pictures and copied to the clipboard.")],
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        return path

    def _screen_width(self):
        outputs = ask({"get": "outputs"})
        if isinstance(outputs, list) and outputs:
            return int(outputs[0].get("width", 0)) or 1
        screen = QGuiApplication.primaryScreen()
        return screen.geometry().width() if screen else 1

