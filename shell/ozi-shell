#!/usr/bin/env python3
"""ozi-shell: the OziOS bar, dock, launcher, quick panel and wallpaper.

Runs inside oziwm. Every window is a wlr-layer-shell surface (layer-shell-qt);
the logic lives in ozipkg.shell, this file only carries it to QML.

    ozi-shell                start the shell
    ozi-shell --launcher     open or close the launcher of the running shell
"""
import json
import os
import socket
import subprocess
import sys
import threading

HERE = os.path.dirname(os.path.realpath(__file__))
# A checkout uses its own code; an installed shell finds /usr/lib/ozios/python.
for root in (os.path.join(HERE, "..", "python"), "/usr/lib/ozios/python", "/usr/lib/ozi-desktop/python"):
    if os.path.isdir(os.path.join(root, "ozipkg")):
        sys.path.insert(0, root)
        break

from ozipkg import i18n, shell, tray  # noqa: E402

QML_DIRS = (os.path.join(HERE, "qml"), "/usr/share/ozios/shell/qml")


def wm_socket():
    path = os.environ.get("OZIWM_SOCKET", "")
    if path and os.path.exists(path):
        return path
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    return os.path.join(runtime, "oziwm-%s.sock" % display)


FAILED = object()


def ask(request, timeout=2.0, default=None):
    """One request to oziwm, its "ok" value back; `default` when it failed."""
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(timeout)
            s.connect(wm_socket())
            s.sendall((json.dumps(request) + "\n").encode())
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data.decode() or "null")
        if isinstance(reply, dict) and "ok" in reply:
            return reply["ok"]
        return default
    except (OSError, ValueError):
        return default


if "--launcher" in sys.argv[1:]:
    sys.exit(1 if ask({"do": "toggle-launcher"}, default=FAILED) is FAILED else 0)

# The shell's own windows are layer surfaces. Programs it starts must not
# inherit this, or Qt programs (Konsole, Dolphin...) open as layers, not windows.
_own_layer_shell = "QT_WAYLAND_SHELL_INTEGRATION" not in os.environ
os.environ.setdefault("QT_WAYLAND_SHELL_INTEGRATION", "layer-shell")
os.environ.setdefault("QT_QPA_PLATFORM", "wayland")

from PyQt6.QtCore import QFileSystemWatcher, QObject, QTimer, QUrl, pyqtClassInfo, pyqtProperty, pyqtSignal, pyqtSlot  # noqa: E402
from PyQt6.QtDBus import QDBusAbstractAdaptor, QDBusConnection, QDBusMessage  # noqa: E402
from PyQt6.QtGui import QGuiApplication, QIcon, QRegion  # noqa: E402
from PyQt6.QtQml import QQmlApplicationEngine  # noqa: E402


class Shell(QObject):
    windowsChanged = pyqtSignal()
    appsChanged = pyqtSignal()
    statusChanged = pyqtSignal()
    lookChanged = pyqtSignal()
    launcherRequested = pyqtSignal()
    panelRequested = pyqtSignal()
    startingChanged = pyqtSignal()
    networksChanged = pyqtSignal()
    # Alt+Tab: the windows offered (most recent first) and the one chosen; empty when done.
    switcherChanged = pyqtSignal()
    clipboardChanged = pyqtSignal()
    clipboardRequested = pyqtSignal()
    areaShotRequested = pyqtSignal()
    # A key changed sound or brightness: show the little gauge (kind, percent).
    osd = pyqtSignal(str, int)
    wifiResult = pyqtSignal(str, bool, bool, str)   # ssid, ok, needs password, message
    _statusReady = pyqtSignal(dict)
    _partReady = pyqtSignal(str, "QVariant")
    _osdReady = pyqtSignal(str, int)
    _event = pyqtSignal(dict)
    _colorsReady = pyqtSignal()

    def __init__(self):
        super().__init__()
        self._windows = []
        self._workspaces = [{"index": i, "active": i == 1, "windows": 0, "tiling": False} for i in range(1, 5)]
        self._apps = shell.applications()
        self._wallpapers = shell.wallpapers()
        self._by_id = {a["id"]: a for a in self._apps}
        self._status = {"volume": {"available": False, "percent": 0, "muted": False},
                        "battery": {"present": False}, "network": {"kind": "none", "name": ""},
                        "wifi": {"available": False, "wifi": False, "wifi_hw": False},
                        "bluetooth": {"available": False, "powered": False, "devices": []},
                        "airplane": False, "brightness": {"available": False, "percent": 100}, "power": ""}
        self._look = shell.look()
        self._pending_look = {}
        self._look_timer = QTimer(self)
        self._look_timer.setSingleShot(True)
        self._look_timer.setInterval(50)
        self._look_timer.timeout.connect(self._flush_look)
        # The look file changed from outside (`ozi theme`, another program): follow it.
        self._watcher = QFileSystemWatcher(self)
        self._watch_config()
        self._watcher.fileChanged.connect(self._config_changed)
        self._watcher.directoryChanged.connect(self._config_changed)
        self._starting = {}
        self._networks = []
        self._switcher = {"ids": [], "index": 0}
        self._clipboard = []
        self._statusReady.connect(self._set_status)
        self._partReady.connect(self._set_part)
        self._osdReady.connect(self.osd)
        self._event.connect(self._on_event)
        self._colorsReady.connect(self._colors_ready)
        self._colors_busy = False
        self._update_colors()
        self._refresh_windows()
        threading.Thread(target=self._listen, daemon=True).start()
        self._timer = QTimer(self)
        self._timer.timeout.connect(self.refreshStatus)
        self._timer.start(4000)
        self.refreshStatus()

    # ---- events from oziwm ------------------------------------------------

    def _listen(self):
        """Subscribe and turn each event line into a Qt signal (thread-safe)."""
        import time
        while True:
            try:
                with socket.socket(socket.AF_UNIX) as s:
                    s.connect(wm_socket())
                    s.sendall(b'{"subscribe":["windows","shell"]}\n')
                    buffer = b""
                    while True:
                        chunk = s.recv(65536)
                        if not chunk:
                            break
                        buffer += chunk
                        while b"\n" in buffer:
                            line, buffer = buffer.split(b"\n", 1)
                            try:
                                message = json.loads(line)
                            except ValueError:
                                continue
                            if isinstance(message, dict) and "event" in message:
                                self._event.emit(message)
            except OSError:
                pass
            time.sleep(1.0)

    def _on_event(self, message):
        event = message.get("event")
        if event == "launcher":
            self.launcherRequested.emit()
        elif event == "panel":
            self.panelRequested.emit()
        elif event == "key":
            self._key(message.get("key", ""))
        elif event == "switcher":
            self._switcher = {"ids": list(message.get("ids", [])), "index": int(message.get("index", 0))}
            self.switcherChanged.emit()
        elif event == "switcher-end":
            self._switcher = {"ids": [], "index": 0}
            self.switcherChanged.emit()
        elif event == "clipboard":
            self._load_clipboard()
            self.clipboardRequested.emit()
        elif event == "clipboard-changed":
            self._load_clipboard()
        elif event == "screenshot-area":
            self.areaShotRequested.emit()
        else:
            self._refresh_windows()

    def _key(self, key):
        """Sound, brightness, media and radio keys, forwarded by oziwm."""
        def run():
            if key in ("volume-up", "volume-down"):
                current = shell.volume()
                step = 5 if key == "volume-up" else -5
                vol = shell.set_volume(max(0, min(100, current["percent"] + step)))
                self._partReady.emit("volume", vol)
                self._osdReady.emit("volume", vol["percent"])
            elif key == "mute":
                vol = shell.toggle_mute()
                self._partReady.emit("volume", vol)
                self._osdReady.emit("muted" if vol["muted"] else "volume", vol["percent"])
            elif key == "mic-mute":
                shell._run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"])
                self._osdReady.emit("mic", 0)
            elif key in ("brightness-up", "brightness-down"):
                current = shell.brightness()
                step = 10 if key == "brightness-up" else -10
                b = shell.set_brightness(current["percent"] + step)
                self._partReady.emit("brightness", b)
                self._osdReady.emit("brightness", b["percent"])
            elif key in ("play-pause", "next", "previous"):
                shell.media(key)
            elif key == "airplane":
                on = not self._status.get("airplane", False)
                shell.set_airplane(on)
                self._statusReady.emit(shell.full_status())
                self._osdReady.emit("airplane-on" if on else "airplane-off", 0)
        threading.Thread(target=run, daemon=True).start()

    def _refresh_windows(self):
        windows = ask({"get": "windows"})
        if isinstance(windows, list):
            self._windows = windows
            # The program we started has its window: stop saying it is starting.
            if self._starting and any(
                (shell.match_app(self._by_id, w.get("app_id", "")) or {}).get("id") == self._starting.get("id")
                or w.get("app_id", "").casefold() == self._starting.get("wm", "").casefold()
                for w in windows
            ):
                self._starting = {}
                self.startingChanged.emit()
        workspaces = ask({"get": "workspaces"})
        if isinstance(workspaces, list):
            self._workspaces = workspaces
        self.windowsChanged.emit()

    def _load_clipboard(self):
        items = ask({"get": "clipboard"})
        self._clipboard = items if isinstance(items, list) else []
        self.clipboardChanged.emit()

    # ---- properties -------------------------------------------------------

    @pyqtProperty("QVariantList", notify=switcherChanged)
    def switcherWindows(self):
        """The Alt+Tab list: each window with its app's name and icon."""
        by_id = {w.get("id"): w for w in self._windows}
        out = []
        for wid in self._switcher["ids"]:
            w = by_id.get(wid)
            if w is None:
                continue
            app = shell.match_app(self._by_id, w.get("app_id", "")) or {}
            out.append({"id": wid, "title": w.get("title") or app.get("name", ""),
                        "name": app.get("name") or w.get("app_id", ""), "icon": app.get("icon", "")})
        return out

    @pyqtProperty(int, notify=switcherChanged)
    def switcherIndex(self):
        return self._switcher["index"]

    @pyqtProperty("QVariantList", notify=clipboardChanged)
    def clipboard(self):
