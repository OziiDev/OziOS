  <method name="GetCapabilities"><arg type="as" direction="out"/></method>
  <method name="Notify">
    <arg type="s" direction="in"/><arg type="u" direction="in"/><arg type="s" direction="in"/>
    <arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="as" direction="in"/>
    <arg type="a{sv}" direction="in"/><arg type="i" direction="in"/><arg type="u" direction="out"/>
  </method>
  <method name="CloseNotification"><arg type="u" direction="in"/></method>
  <method name="GetServerInformation">
    <arg type="s" direction="out"/><arg type="s" direction="out"/>
    <arg type="s" direction="out"/><arg type="s" direction="out"/>
  </method>
  <signal name="NotificationClosed"><arg type="u"/><arg type="u"/></signal>
  <signal name="ActionInvoked"><arg type="u"/><arg type="s"/></signal>
</interface>
'''


@pyqtClassInfo("D-Bus Interface", "org.freedesktop.Notifications")
@pyqtClassInfo("D-Bus Introspection", NOTIFY_XML)
class NotificationAdaptor(QDBusAbstractAdaptor):
    """org.freedesktop.Notifications on the session bus, for every program."""
    NotificationClosed = pyqtSignal("uint", "uint")
    ActionInvoked = pyqtSignal("uint", str)

    def __init__(self, owner):
        super().__init__(owner)
        self.owner = owner
        self.setAutoRelaySignals(True)

    @pyqtSlot(result="QStringList")
    def GetCapabilities(self):
        return ["body", "body-markup", "actions", "icon-static"]

    @pyqtSlot(QDBusMessage)
    def GetServerInformation(self, message):
        message.setDelayedReply(True)
        QDBusConnection.sessionBus().send(message.createReply(["OziOS", "OziOS", "0.4", "1.2"]))

    @pyqtSlot(str, "uint", str, str, str, "QStringList", "QVariantMap", int, result="uint")
    def Notify(self, app_name, replaces_id, app_icon, summary, body, actions, hints, timeout):
        return self.owner.add(app_name, replaces_id, app_icon, summary, body, list(actions), dict(hints), timeout)

    @pyqtSlot("uint")
    def CloseNotification(self, nid):
        self.owner.dismiss(nid, 3)


TRAY_XML = """
  <interface name="org.kde.StatusNotifierWatcher">
    <method name="RegisterStatusNotifierItem"><arg name="service" type="s" direction="in"/></method>
    <method name="RegisterStatusNotifierHost"><arg name="service" type="s" direction="in"/></method>
    <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
    <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
    <property name="ProtocolVersion" type="i" access="read"/>
    <signal name="StatusNotifierItemRegistered"><arg type="s"/></signal>
    <signal name="StatusNotifierItemUnregistered"><arg type="s"/></signal>
    <signal name="StatusNotifierHostRegistered"/>
  </interface>
"""


@pyqtClassInfo("D-Bus Interface", "org.kde.StatusNotifierWatcher")
@pyqtClassInfo("D-Bus Introspection", TRAY_XML)
class TrayWatcherAdaptor(QDBusAbstractAdaptor):
    """org.kde.StatusNotifierWatcher: background programs register their tray icon here."""
    StatusNotifierItemRegistered = pyqtSignal(str)
    StatusNotifierItemUnregistered = pyqtSignal(str)
    StatusNotifierHostRegistered = pyqtSignal()

    def __init__(self, owner):
        super().__init__(owner)
        self.owner = owner
        self.setAutoRelaySignals(False)

    @pyqtSlot(str, QDBusMessage)
    def RegisterStatusNotifierItem(self, service, message):
        self.owner.register(service, message.service())

    @pyqtSlot(str)
    def RegisterStatusNotifierHost(self, service):
        pass  # ozi-shell is the host

    @pyqtProperty("QStringList")
    def RegisteredStatusNotifierItems(self):
        return list(self.owner.services)

    @pyqtProperty(bool)
    def IsStatusNotifierHostRegistered(self):
        return True

    @pyqtProperty(int)
    def ProtocolVersion(self):
        return 0


class Tray(QObject):
    """The tray icons in the bar: who registered, how they look, their menus."""
    changed = pyqtSignal()
    menuReady = pyqtSignal(str, "QVariantList")
    _itemReady = pyqtSignal(str, "QVariantMap")

    def __init__(self):
        super().__init__()
        self.services = []
        self._items = {}
        self._itemReady.connect(self._set_item)
        self.adaptor = TrayWatcherAdaptor(self)
        bus = QDBusConnection.sessionBus()
        self.active = bus.registerObject("/StatusNotifierWatcher", self) and \
            bus.registerService("org.kde.StatusNotifierWatcher")
        if not self.active:
            print("ozi-shell: another tray watcher is running", file=sys.stderr)
        # A program that quits takes its icon with it.
        bus.connect("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                    "NameOwnerChanged", self._owner_changed)
        # Icons change (new message, muted...): read the item again.
        for signal in ("NewIcon", "NewStatus", "NewToolTip", "NewTitle", "NewAttentionIcon"):
            bus.connect("", "", tray.ITEM_IFACE, signal, self._item_changed)
        self.adaptor.StatusNotifierHostRegistered.emit()

    def register(self, service, sender):
        name, path = tray.split_service(service, sender)
        key = name + path
        if key in self.services:
            return
        self.services.append(key)
        self.adaptor.StatusNotifierItemRegistered.emit(key)
        self._read(key)

    @pyqtSlot(QDBusMessage)
    def _item_changed(self, message):
        sender = message.service()
        for key in self.services:
            if key.startswith(sender + "/"):
                self._read(key)

    @pyqtSlot(str, str, str)
    def _owner_changed(self, name, old, new):
        if new:
            return
        gone = [k for k in self.services if k.startswith(name + "/")]
        for key in gone:
            self.services.remove(key)
            self._items.pop(key, None)
            self.adaptor.StatusNotifierItemUnregistered.emit(key)
        if gone:
            self.changed.emit()

    def _read(self, key):
        def run():
            item = tray.read_item(key)
            if item:
                self._itemReady.emit(key, item)
        threading.Thread(target=run, daemon=True).start()

    def _set_item(self, key, item):
        if key in self.services:
            self._items[key] = item
            self.changed.emit()

    @pyqtProperty("QVariantList", notify=changed)
    def items(self):
        return [self._items[k] for k in self.services if k in self._items and self._items[k]["status"] != "Passive"]

    @pyqtSlot(str, int, int)
    def activate(self, key, x, y):
        item = self._items.get(key, {})
        if item.get("itemIsMenu") and item.get("menu"):
            self.openMenu(key)
            return
        threading.Thread(target=lambda: tray.activate(key, x, y) or (item.get("menu") and self.openMenu(key)),
                         daemon=True).start()

    @pyqtSlot(str)
    def openMenu(self, key):
        item = self._items.get(key, {})
        if not item.get("menu"):
            return
        threading.Thread(target=lambda: self.menuReady.emit(key, tray.menu(key, item["menu"])), daemon=True).start()

    @pyqtSlot(str, int)
    def menuClick(self, key, entry_id):
        item = self._items.get(key, {})
        if item.get("menu"):
            threading.Thread(target=lambda: tray.menu_click(key, item["menu"], entry_id), daemon=True).start()


class Notifications(QObject):
    """The popups on screen and what QML needs to draw them."""
    changed = pyqtSignal()

    def __init__(self):
        super().__init__()
        self._items = []
        self._next = 1
        self._quiet = False
        self.adaptor = NotificationAdaptor(self)
        bus = QDBusConnection.sessionBus()
        self.registered = bus.registerObject("/org/freedesktop/Notifications", self) and \
            bus.registerService("org.freedesktop.Notifications")
        if not self.registered:
            print("ozi-shell: another notification server is running; popups stay with it", file=sys.stderr)

    def add(self, app, replaces, icon, summary, body, actions, hints, timeout):
        nid = replaces if replaces else self._next
        if not replaces:
            self._next += 1
        urgency = int(hints.get("urgency", 1)) if str(hints.get("urgency", 1)).isdigit() else 1
        if timeout < 0:
            timeout = 0 if urgency == 2 else 6000
        icon = icon or str(hints.get("image-path") or hints.get("image_path") or "") \
            or str(hints.get("desktop-entry") or "") or "dialog-information"
        item = {"id": nid, "app": app, "icon": icon,
                "summary": summary, "body": body, "timeout": timeout, "critical": urgency == 2,
                "actions": [{"key": actions[i], "label": actions[i + 1]} for i in range(0, len(actions) - 1, 2)]}
        self._items = [i for i in self._items if i["id"] != nid] + [item]
        if self._quiet and not item["critical"]:
            self._items = [i for i in self._items if i["id"] != nid]
        self._items = self._items[-5:]
        self.changed.emit()
        return nid

    def dismiss(self, nid, reason):
        before = len(self._items)
        self._items = [i for i in self._items if i["id"] != nid]
        if len(self._items) != before:
            self.adaptor.NotificationClosed.emit(nid, reason)
            self.changed.emit()

    @pyqtProperty("QVariantList", notify=changed)
    def items(self):
        return self._items

    @pyqtProperty(bool, notify=changed)
    def quiet(self):
        return self._quiet

    @pyqtSlot(bool)
    def setQuiet(self, quiet):
        self._quiet = quiet
        self.changed.emit()

    @pyqtSlot(int)
    def expire(self, nid):
        self.dismiss(nid, 1)

    @pyqtSlot(int)
    def close(self, nid):
        self.dismiss(nid, 2)

    @pyqtSlot(int, str)
    def invoke(self, nid, key):
        self.adaptor.ActionInvoked.emit(nid, key)
        self.dismiss(nid, 2)


def main():
    app = QGuiApplication(sys.argv)
    if _own_layer_shell:
        # Read by Qt while the application started; programs started from here get a clean one.
        os.environ.pop("QT_WAYLAND_SHELL_INTEGRATION", None)
    # Hiding the launcher or the quick panel must not end the shell: Qt would
    # quit when the "last window" closes, taking the bar, dock and wallpaper along.
    app.setQuitOnLastWindowClosed(False)
    app.setApplicationName("ozi-shell")
    app.setDesktopFileName("ozi-shell")
    if not QIcon.themeName():
        QIcon.setThemeName("breeze-dark")
    backend = Shell()
    engine = QQmlApplicationEngine()
    # QML mistakes go to the shell log (~/.local/state/oziwm/shell.log).
    engine.warnings.connect(lambda warnings: [print("qml:", w.toString(), file=sys.stderr) for w in warnings])
    engine.addImageProvider("icon", IconProvider())
    engine.rootContext().setContextProperty("Shell", backend)
    notifications = Notifications()
    engine.rootContext().setContextProperty("Notes", notifications)
    tray_icons = Tray()
    engine.rootContext().setContextProperty("Tray", tray_icons)
    qml = next((d for d in QML_DIRS if os.path.exists(os.path.join(d, "Main.qml"))), None)
    if not qml:
        sys.exit("ozi-shell: QML files not found")
    engine.load(QUrl.fromLocalFile(os.path.join(qml, "Main.qml")))
    if not engine.rootObjects():
        sys.exit("ozi-shell: the QML did not load")
    sys.exit(app.exec())


from PyQt6.QtCore import QSize  # noqa: E402
from PyQt6.QtQuick import QQuickImageProvider  # noqa: E402


class IconProvider(QQuickImageProvider):
    """Icons from the icon theme, by name."""

    def __init__(self):
        super().__init__(QQuickImageProvider.ImageType.Pixmap)

    def requestPixmap(self, name, requested, size=None):
        side = max(requested.width(), requested.height(), 64) if requested.isValid() else 64
        icon = QIcon.fromTheme(name)
        if icon.isNull():
            icon = QIcon.fromTheme("application-x-executable")
        pixmap = icon.pixmap(QSize(side, side))
        return pixmap, pixmap.size()


if __name__ == "__main__":
    main()
