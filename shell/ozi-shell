    def themes(self):
        return [shell.palette(t, self._look.get("colors") if t == shell.AUTO else None)
                for t in shell.theme_ids()]

    def _update_colors(self):
        """The "auto" theme: work the colours out of a new wallpaper, off the UI thread."""
        if self._colors_busy or self._look.get("theme") != shell.AUTO:
            return
        self._colors_busy = True

        def run():
            try:
                changed = shell.update_wallpaper_colors()
            except Exception as err:  # a broken picture must not take the shell down
                print("ozi-shell: wallpaper colours:", err, file=sys.stderr)
                changed = False
            self._colors_busy = False
            if changed:
                self._colorsReady.emit()
        threading.Thread(target=run, daemon=True).start()

    def _colors_ready(self):
        self._look = shell.look()
        ask({"do": "reload-look"})
        self.lookChanged.emit()

    # ---- actions ----------------------------------------------------------

    @pyqtSlot(str, result="QVariantList")
    def search(self, query):
        return shell.search(self._apps, query)

    @pyqtSlot(str)
    def launch(self, app_id):
        app = self._by_id.get(app_id)
        if not app:
            return
        argv = shell.command_for(app["exec"], app["terminal"])
        # Some programs take seconds to show a window; say so in the bar meanwhile.
        self._starting = {"id": app_id, "name": app["name"], "icon": app["icon"], "wm": app.get("wm_class") or app_id}
        self.startingChanged.emit()
        QTimer.singleShot(20000, self._starting_timeout)
        try:
            subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    @pyqtSlot(str)
    def activateDockItem(self, item_id):
        """Click on a dock icon: start it, bring it up, or minimise it if it is in front."""
        item = next((i for i in self.dock if i["id"] == item_id), None)
        if not item:
            return
        if not item["windows"]:
            self.launch(item_id)
            return
        if item["active"] and len(item["windows"]) == 1:
            ask({"do": "minimize", "id": item["windows"][0]})
            return
        # Several windows: the next one in turn.
        focused = next((w["id"] for w in self._windows if w.get("focused")), None)
        ids = item["windows"]
        target = ids[(ids.index(focused) + 1) % len(ids)] if focused in ids else ids[-1]
        ask({"do": "focus", "id": target})

    @pyqtSlot(str, bool)
    def setPinned(self, app_id, pinned):
        current = shell.pins(self._by_id)
        if pinned and app_id not in current:
            current.append(app_id)
        if not pinned:
            current = [p for p in current if p != app_id]
        shell.write_config({"dock": current})
        self.windowsChanged.emit()

    @pyqtSlot(str, int)
    def movePin(self, app_id, index):
        """Put a dock item at this place among the pinned ones (pinning it if it was not)."""
        if app_id not in self._by_id:
            return
        current = [p for p in shell.pins(self._by_id) if p != app_id]
        current.insert(max(0, min(index, len(current))), app_id)
        shell.write_config({"dock": current})
        self.windowsChanged.emit()

    @pyqtSlot(int)
    def focusWindow(self, window_id):
        ask({"do": "focus", "id": window_id})

    @pyqtSlot(int)
    def closeWindow(self, window_id):
        ask({"do": "close", "id": window_id})

    @pyqtSlot(str, "QVariant")
    def setLook(self, key, value):
        """Change one look setting; the compositor redraws every frame with it at once."""
        if key not in shell.LOOK_DEFAULTS:
            return
        if key in ("corner_radius", "lock_after_minutes"):
            value = int(round(float(value)))
        # The slider moves at once; the file and oziwm follow at most ~20 times a second.
        self._look = dict(self._look, **{key: value})
        self._pending_look[key] = value
        if not self._look_timer.isActive():
            self._look_timer.start()
        self.lookChanged.emit()

    def _watch_config(self):
        path = shell.desktop_config_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        for p in (path, os.path.dirname(path)):
            if os.path.exists(p) and p not in self._watcher.files() + self._watcher.directories():
                self._watcher.addPath(p)

    def _config_changed(self, _path):
        if self._pending_look:
            return  # our own write is on its way
        self._watch_config()  # an atomic replace drops the watch on the old file
        look = shell.look()
        if look != self._look:
            self._look = look
            self.lookChanged.emit()
        self._update_colors()

    def _flush_look(self):
        if not self._pending_look:
            return
        shell.write_config(self._pending_look)
        self._pending_look = {}
        self._look = shell.look()
        ask({"do": "reload-look"})
        self.lookChanged.emit()
        self._update_colors()

    def _starting_timeout(self):
        if self._starting:
            self._starting = {}
            self.startingChanged.emit()

    @pyqtProperty("QVariantMap", notify=startingChanged)
    def starting(self):
        return self._starting

    @pyqtProperty("QVariantList", notify=networksChanged)
    def networks(self):
        return self._networks

    def _background(self, key, fn, *args):
        threading.Thread(target=lambda: self._partReady.emit(key, fn(*args)), daemon=True).start()

    def _set_part(self, key, value):
        if key == "networks":
            self._networks = value or []
            self.networksChanged.emit()
            return
        if key == "radios":
            self._status = dict(self._status, wifi=value["wifi"], bluetooth=value["bluetooth"],
                                airplane=shell.airplane(value["wifi"], value["bluetooth"]))
        else:
            self._status = dict(self._status, **{key: value})
            if key in ("wifi", "bluetooth"):
                self._status["airplane"] = shell.airplane(self._status.get("wifi", {}), self._status.get("bluetooth", {}))
        self.statusChanged.emit()

    @pyqtSlot(bool)
    def setWifi(self, on):
        self._background("wifi", shell.set_wifi, on)

    @pyqtSlot()
    def scanNetworks(self):
        self._background("networks", shell.wifi_networks)

    @pyqtSlot(str, str)
    def connectWifi(self, ssid, password):
