#!/usr/bin/env bash
# Run a Windows program or file in the OziOS Windows guest.
#
#   ozi-winrun <file.exe | file.msi | program>   open it in its own window
#   ozi-winrun --desktop                        the whole Windows desktop
#   ozi-winrun --start | --stop                 start or shut down the guest
#   ozi-winrun --status                         one JSON line for ozi-shell
#
# Tries a seamless RemoteApp window first, then a full Windows desktop
# window, then gives up and points at the reboot option.
set -u

conf="${XDG_CONFIG_HOME:-$HOME/.config}/ozi/winbridge.conf"
VM="ozi-win"
RDP_HOST=""        # empty: ask libvirt for the guest's address
RDP_PORT="3389"
RDP_USER="ozi"
RDP_PASS_CMD="secret-tool lookup service ozi-winvm"   # keeps the password out of this file
SHARE='\\tsclient\home'   # $HOME, redirected into the session by the RDP client
[ -f "$conf" ] && . "$conf"

SETUP_ISO=/var/lib/libvirt/images/ozi-setup.iso
target="${1:-}"
if [ -z "$target" ]; then
  echo "usage: ozi-winrun <file.exe | file.msi | program> | --desktop | --start | --stop | --status" >&2
  exit 2
fi

notify() {
  command -v notify-send >/dev/null && notify-send "OziOS" "$1"
  echo "$1" >&2
}

start_guest() {
  local state
  state="$(virsh -c qemu:///system domstate "$VM" 2>/dev/null || echo missing)"
  case "$state" in
    running) ;;
    missing) exec ozi-winsetup --gui ;;
    *) virsh -c qemu:///system start "$VM" >/dev/null || { notify "Could not start Windows."; exit 4; } ;;
  esac
  # A cold boot needs time both to get an address and to bring RDP up.
  for _ in $(seq 1 120); do
    [ -n "$RDP_HOST" ] || RDP_HOST="$(guest_address)"
    if rdp_open "$RDP_HOST"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# The guest account's password: from the keyring, or, when the keyring lost it,
# from the answer file on the setup CD (which put it into Windows), stored back.
guest_password() {
  local pw
  pw="$($RDP_PASS_CMD 2>/dev/null)"
  if [ -z "$pw" ] && [ -r "$SETUP_ISO" ]; then
    pw="$(bsdtar -xOf "$SETUP_ISO" autounattend.xml 2>/dev/null |
      sed -n '/<LocalAccount /,/<\/LocalAccount>/s:.*<Value>\(.*\)</Value>.*:\1:p' | head -n 1)"
    [ -n "$pw" ] && printf '%s' "$pw" | secret-tool store --label="OziOS Windows guest" service ozi-winvm 2>/dev/null
  fi
  printf '%s' "$pw"
}

rdp_open() {
  [ -n "$1" ] && (exec 3<>"/dev/tcp/$1/$RDP_PORT") 2>/dev/null
}

status_json() {
  local state host="" ready=false
  state="$(virsh -c qemu:///system domstate "$VM" 2>/dev/null | head -n 1)"
  [ -n "$state" ] || state=missing
  if [ "$state" = running ]; then
    host="$(guest_address)"
    rdp_open "$host" && ready=true
  fi
  # running without RDP yet: booting, or Windows Setup still installing.
  printf '{"state": "%s", "ready": %s, "address": "%s"}\n' "$state" "$ready" "$host"
}

guest_address() {
  virsh -c qemu:///system domifaddr "$VM" 2>/dev/null |
    awk '$3 == "ipv4" { sub(/\/.*/, "", $4); print $4; exit }'
}

# Files under $HOME are already visible in the guest; anything else is copied
# into a shared inbox first.
guest_path() {
  local rel
  case "$1" in
    "$HOME"/*)
      rel="${1#"$HOME"/}"
      printf '%s\\%s' "$SHARE" "${rel//\//\\}"
      ;;
    *)
      mkdir -p "$HOME/.cache/ozi/inbox" && cp -f "$1" "$HOME/.cache/ozi/inbox/" || return 1
      printf '%s\\.cache\\ozi\\inbox\\%s' "$SHARE" "$(basename "$1")"
      ;;
  esac
}

rdp() {
  xfreerdp3 /v:"$RDP_HOST":"$RDP_PORT" /u:"$RDP_USER" /p:"$(guest_password)" \
    /cert:ignore +clipboard /sound /drive:home,"$HOME" "$@"
}

case "$target" in
  --status) status_json; exit 0 ;;
  --start) virsh -c qemu:///system start "$VM" >/dev/null 2>&1; status_json; exit 0 ;;
  --stop) virsh -c qemu:///system shutdown "$VM" >/dev/null 2>&1; status_json; exit 0 ;;
  --desktop)
    start_guest || { notify "Windows henüz hazır değil: kuruluyor ya da açılıyor olabilir. Biraz sonra yeniden dene."; exit 5; }
    rdp /dynamic-resolution /size:1600x900 +auto-reconnect && exit 0
    command -v virt-viewer >/dev/null && exec virt-viewer -c qemu:///system "$VM"
    exit 6 ;;
esac

notify "$(basename "$target") Windows'ta açılıyor…"
start_guest || { notify "Windows henüz hazır değil: kuruluyor ya da açılıyor olabilir. Biraz sonra yeniden dene."; exit 5; }

if [ -e "$target" ]; then
  winpath="$(guest_path "$(readlink -f "$target")")" || { notify "Could not share $target with Windows."; exit 5; }
else
  winpath="$target"
fi

if rdp /app:program:"cmd.exe",cmd:"/c start \"\" \"$winpath\"",name:"$(basename "$target")" /dynamic-resolution; then
  exit 0
fi

notify "Uygulama penceresi açılamadı; Windows masaüstü açılıyor."
rdp /dynamic-resolution /size:1600x900 && exit 0
command -v virt-viewer >/dev/null && virt-viewer -c qemu:///system "$VM" && exit 0

notify "Windows penceresi açılamadı. Gerçek Windows'u başlatmak için: ozi reboot-windows"
exit 6
