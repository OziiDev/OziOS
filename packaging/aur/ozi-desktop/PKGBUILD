# Maintainer: OziiDev <OziiDev@users.noreply.github.com>
#
# The OziOS desktop for any Arch-based system: oziwm (a Wayland compositor)
# and ozi-shell (bar, dock, launcher, quick settings, notifications, lock
# screen, wallpapers). Adds an "OziOS" session to the login screen; the
# system itself stays as it is.
pkgname=ozi-desktop
pkgver=0.4.0beta1
_tag=v0.4.0-beta1
pkgrel=1
pkgdesc="OziOS desktop: its own Wayland compositor and shell, Hyprland-pretty and Plasma-easy"
arch=(x86_64)
url="https://github.com/OziiDev/OziOS"
license=(MIT)
depends=(
  seatd libinput mesa libxkbcommon systemd-libs libdrm pam
  python python-pyqt6 qt6-declarative qt6-svg layer-shell-qt
  ttf-overpass wireplumber networkmanager bluez-utils power-profiles-daemon
  xdg-desktop-portal-kde xdg-desktop-portal-gtk
)
makedepends=(rust cargo clang)
optdepends=(
  'xwayland-satellite: run X11 programs (Steam, older games)'
  'breeze: the default pointer theme'
  'polkit-kde-agent: password prompts for administrator tasks'
  'konsole: the terminal Super+Return opens'
  'dolphin: the file manager Super+E opens'
  'cachyos-wallpapers: more wallpapers in the picker'
)
backup=(etc/pam.d/oziwm)
options=(!lto)
source=("OziOS-$_tag.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP')

_src() { echo "$srcdir/OziOS-${_tag#v}"; }

build() {
  cd "$(_src)/oziwm"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

check() {
  cd "$(_src)/oziwm"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked
}

package() {
  local src; src="$(_src)"
  install -Dm755 "$srcdir/target/release/oziwm" "$pkgdir/usr/bin/oziwm"
  install -Dm755 "$src/shell/ozi-shell" "$pkgdir/usr/bin/ozi-shell"
  install -Dm755 "$src/session/ozi-session" "$pkgdir/usr/bin/ozi-session"
  install -Dm755 "$src/session/ozi-session-start" "$pkgdir/usr/lib/ozios/ozi-session-start"
  install -Dm644 "$src/session/ozios.desktop" "$pkgdir/usr/share/wayland-sessions/ozios.desktop"
  install -Dm644 "$src/session/oziwm.pam" "$pkgdir/etc/pam.d/oziwm"
  install -Dm644 "$src/session/ozios-portals.conf" "$pkgdir/usr/share/xdg-desktop-portal/ozios-portals.conf"
  install -d "$pkgdir/usr/share/ozios/shell/qml" "$pkgdir/usr/share/ozios/wallpapers"
  install -m644 "$src"/shell/qml/*.qml "$pkgdir/usr/share/ozios/shell/qml/"
  install -m644 "$src"/branding/wallpapers/*.svg "$pkgdir/usr/share/ozios/wallpapers/"
  # The shell's own Python, apart from OziOS's system tools.
  install -d "$pkgdir/usr/lib/ozi-desktop/python/ozipkg"
  install -m644 "$src"/python/ozipkg/{__init__,shell,themes,i18n,paths}.py "$pkgdir/usr/lib/ozi-desktop/python/ozipkg/"
  install -Dm644 "$src/data/i18n/tr.json" "$pkgdir/usr/lib/ozi-desktop/data/i18n/tr.json"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
