#!/usr/bin/python3
"""Screen pen: draw on top of whatever is on the screen, for a board or a projector."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
sys.path.insert(0, "/usr/lib/ozios/apps")

# On a Wayland desktop with layer-shell (OziOS's own, Plasma, Hyprland...) the
# drawing layer and the toolbar are overlay layers: above every window and the
# bars, the toolbar along the bottom. Elsewhere they are ordinary windows.
LAYER_QML = [os.path.join(p, "org", "kde", "layershell") for p in ("/usr/lib/qt6/qml", "/usr/lib64/qt6/qml")]
LAYER = bool(os.environ.get("WAYLAND_DISPLAY")) and "--window" not in sys.argv and any(os.path.isdir(p) for p in LAYER_QML)
if LAYER:
    os.environ["QT_WAYLAND_SHELL_INTEGRATION"] = "layer-shell"

import ozi_qt  # noqa: E402
from PyQt6.QtCore import QObject, QStandardPaths, pyqtSlot  # noqa: E402
from PyQt6.QtGui import QRegion  # noqa: E402


class PenBackend(ozi_qt.Backend):
    allowed = {}           # everything happens in the interface; only translation is needed

    @pyqtSlot(result=bool)
    def demo(self):
        """--demo draws a few strokes, to check the drawing without a pointer."""
        return "--demo" in sys.argv

    @pyqtSlot(QObject, "QVariantList")
    def setInputRegion(self, window, rects):
        """Only these parts of the window take input; empty: all of it."""
        region = QRegion()
        for i in range(0, len(rects) - 3, 4):
            x, y, w, h = (round(float(v)) for v in rects[i:i + 4])
            if w > 0 and h > 0:
                region = region.united(QRegion(x, y, w, h))
        try:
            window.setMask(region)
        except AttributeError:
            pass

    @pyqtSlot(result=bool)
    def layerShell(self):
        return LAYER

    @pyqtSlot(result=str)
    def picturesDir(self):
        """The folder saved drawings go to, made if it does not exist; empty if that fails."""
        base = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.PicturesLocation) or os.path.expanduser("~")
        path = os.path.join(base, "ozi-pen")
        try:
            os.makedirs(path, exist_ok=True)
        except OSError:
            return ""
        return path


def layered(qml_file):
    """Main.qml with the layer-shell settings filled in at its "// layer:" lines."""
    import tempfile
    with open(qml_file, encoding="utf-8") as f:
        text = f.read()
    parts = {
        "// layer: import": 'import org.kde.layershell 1.0 as LS',
        "// layer: board": "\n".join([
            'LS.Window.scope: "ozi-pen"',
            "LS.Window.layer: LS.Window.LayerOverlay",
            "LS.Window.anchors: LS.Window.AnchorTop | LS.Window.AnchorBottom | LS.Window.AnchorLeft | LS.Window.AnchorRight",
            "LS.Window.exclusionZone: -1",
            "LS.Window.keyboardInteractivity: LS.Window.KeyboardInteractivityOnDemand",
        ]),
    }
    for mark, code in parts.items():
        text = text.replace(mark, code)
    out = tempfile.mkdtemp(prefix="ozi-pen-")
    path = os.path.join(out, "Main.qml")
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    return path


if __name__ == "__main__":
    here = os.path.dirname(os.path.realpath(__file__))
    qml = os.path.join(here, "Main.qml")
    sys.exit(ozi_qt.run(layered(qml) if LAYER else qml, PenBackend(), "Screen pen", "ozi-pen"))
