#!/usr/bin/python3
"""Screen pen: draw on top of whatever is on the screen, for a board or a projector."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
sys.path.insert(0, "/usr/lib/ozios/apps")

import ozi_qt  # noqa: E402
from PyQt6.QtCore import pyqtSlot  # noqa: E402


class PenBackend(ozi_qt.Backend):
    allowed = {}           # everything happens in the interface; only translation is needed

    @pyqtSlot(result=bool)
    def demo(self):
        """--demo draws a few strokes, to check the drawing without a pointer."""
        return "--demo" in sys.argv


if __name__ == "__main__":
    here = os.path.dirname(os.path.realpath(__file__))
    sys.exit(ozi_qt.run(os.path.join(here, "Main.qml"), PenBackend(), "Screen pen", "ozi-pen"))
